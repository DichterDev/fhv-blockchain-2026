[Unit]
Description=ShellShock Blockchain Frontend
After=network-online.target

[Container]
Image=localhost/bct-frontend:latest
ContainerName=bct-frontend
Network=proxy.network

Label=traefik.enable=true
Label=traefik.docker.network=proxy.network
Label=traefik.http.routers.bct-frontend.rule=Host(`blockchain.dichter.dev`)
Label=traefik.http.routers.bct-frontend.entrypoints=websecure
Label=traefik.http.routers.bct-frontend.tls.certresolver=cloudflare
Label=traefik.http.routers.bct-frontend.priority=1
Label=traefik.http.services.bct-frontend.loadbalancer.server.port=80

[Service]
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
